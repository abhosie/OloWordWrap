{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/OloWordWrap.Api/bin/Debug/net10.0/OloWordWrap.Api.dll",
      "cwd": "${workspaceFolder}/src/OloWordWrap.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5081"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/health"
      },
      "stopAtEntry": false,
      "checkForDevCert": false
    }
  ]
}
