meta {
  name: 09 limit not an integer (400)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/word-wrap?limit=abc
  body: json
  auth: none
}

params:query {
  limit: abc
}

body:json {
  { "text": "No utensils" }
}

assert {
  res.status: eq 400
}

tests {
  test("problem+json with errors", function () {
    expect(res.getHeader("content-type")).to.contain("application/problem+json");
    expect(res.getBody().errors).to.be.an("object");
  });
}
