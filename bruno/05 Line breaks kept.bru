meta {
  name: 05 Line breaks kept
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/word-wrap?limit=20
  body: json
  auth: none
}

params:query {
  limit: 20
}

body:json {
  { "text": "No utensils\n\nExtra napkins" }
}

assert {
  res.status: eq 200
}

tests {
  test("lines and wrapped", function () {
    expect(res.getBody().lines).to.eql(["No utensils", "", "Extra napkins"]);
    expect(res.getBody().wrapped).to.eql("No utensils\n\nExtra napkins");
  });
}
