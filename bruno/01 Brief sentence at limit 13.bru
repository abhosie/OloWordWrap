meta {
  name: 01 Brief sentence at limit 13
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/word-wrap?limit=13
  body: json
  auth: none
}

params:query {
  limit: 13
}

body:json {
  { "text": "No utensils please, and cook the steak medium rare" }
}

assert {
  res.status: eq 200
}

tests {
  test("lines and wrapped", function () {
    expect(res.getBody().lines).to.eql(["No utensils", "please, and", "cook the", "steak medium", "rare"]);
    expect(res.getBody().wrapped).to.eql("No utensils\nplease, and\ncook the\nsteak medium\nrare");
  });
}
